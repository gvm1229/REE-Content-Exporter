<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\REE-Content-Editor\ContentEditor.App\ContentEditor.App.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>REE_Content_Exporter</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.6.2</Version>
    <AssemblyVersion>0.6.2.0</AssemblyVersion>
    <FileVersion>0.6.2.0</FileVersion>
    <InformationalVersion>0.6.2</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\fonts\Pretendard-Regular.otf" />
    <EmbeddedResource Include="assets\fonts\Pretendard-SemiBold.otf" />
    <None Include="assets\fonts\Pretendard-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyTexconvToBuildOutput" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <TexconvCandidate Include="$(TexconvPath)" Condition="'$(TexconvPath)' != '' and Exists('$(TexconvPath)')" />
      <TexconvCandidate Include="$(LOCALAPPDATA)\Microsoft\WinGet\Packages\**\texconv.exe" Condition="'@(TexconvCandidate)' == '' and '$(LOCALAPPDATA)' != '' and Exists('$(LOCALAPPDATA)\Microsoft\WinGet\Packages')" />
    </ItemGroup>
    <Error Condition="'@(TexconvCandidate)' == ''" Text="texconv.exe is required for self-contained PNG texture export. Install Microsoft.DirectXTex.Texconv for the build machine or pass -p:TexconvPath=&quot;C:\path\to\texconv.exe&quot;." />
    <Copy SourceFiles="@(TexconvCandidate)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyNativeDependenciesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <AssimpNative Include="$(OutputPath)assimp.dll" Condition="Exists('$(OutputPath)assimp.dll')" />
      <AssimpNative Include="$(OutputPath)runtimes\win-x64\native\assimp.dll" Condition="'@(AssimpNative)' == '' and Exists('$(OutputPath)runtimes\win-x64\native\assimp.dll')" />
      <GDeflateNative Include="$(OutputPath)libGDeflate.dll" Condition="Exists('$(OutputPath)libGDeflate.dll')" />
      <GDeflateNative Include="$(OutputPath)runtimes\win-x64\native\libGDeflate.dll" Condition="'@(GDeflateNative)' == '' and Exists('$(OutputPath)runtimes\win-x64\native\libGDeflate.dll')" />
      <DirectXTexNative Include="$(OutputPath)DirectXTex.dll" Condition="Exists('$(OutputPath)DirectXTex.dll')" />
      <DirectXTexNative Include="$(OutputPath)runtimes\win-x64\native\DirectXTex.dll" Condition="'@(DirectXTexNative)' == '' and Exists('$(OutputPath)runtimes\win-x64\native\DirectXTex.dll')" />
      <TexconvNative Include="$(OutputPath)texconv.exe" Condition="Exists('$(OutputPath)texconv.exe')" />
    </ItemGroup>
    <Copy SourceFiles="@(AssimpNative)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GDeflateNative)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DirectXTexNative)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Error Condition="'@(TexconvNative)' == ''" Text="Publish output is missing texconv.exe. Build/publish with Microsoft.DirectXTex.Texconv installed or pass -p:TexconvPath=&quot;C:\path\to\texconv.exe&quot;." />
    <Copy SourceFiles="@(TexconvNative)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CreateNamedPublishExecutables" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true' and Exists('$(PublishDir)$(AssemblyName).exe')">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)REE-Content-Exporter-GUI.exe" />
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)REE-Content-Exporter-CLI.exe" />
    <Delete Files="$(PublishDir)$(AssemblyName).exe" />
  </Target>

</Project>
