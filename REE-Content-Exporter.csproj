<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\REE-Content-Editor\ContentEditor.App\ContentEditor.App.csproj" />
    <EmbeddedResource Include="pragmata.list" LogicalName="pragmata.list" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>REE_Content_Exporter</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Target Name="CopyNativeDependenciesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <AssimpNative Include="$(OutputPath)assimp.dll" Condition="Exists('$(OutputPath)assimp.dll')" />
      <AssimpNative Include="$(OutputPath)runtimes\win-x64\native\assimp.dll" Condition="'@(AssimpNative)' == '' and Exists('$(OutputPath)runtimes\win-x64\native\assimp.dll')" />
      <GDeflateNative Include="$(OutputPath)libGDeflate.dll" Condition="Exists('$(OutputPath)libGDeflate.dll')" />
      <GDeflateNative Include="$(OutputPath)runtimes\win-x64\native\libGDeflate.dll" Condition="'@(GDeflateNative)' == '' and Exists('$(OutputPath)runtimes\win-x64\native\libGDeflate.dll')" />
      <DirectXTexNative Include="$(OutputPath)DirectXTex.dll" Condition="Exists('$(OutputPath)DirectXTex.dll')" />
      <DirectXTexNative Include="$(OutputPath)runtimes\win-x64\native\DirectXTex.dll" Condition="'@(DirectXTexNative)' == '' and Exists('$(OutputPath)runtimes\win-x64\native\DirectXTex.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(AssimpNative)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GDeflateNative)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DirectXTexNative)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
