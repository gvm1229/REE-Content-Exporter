+    private void ApplyMaterialTextureSlots(Assimp.Scene scene, string filepath)
+    {
+        if (ImportedMaterialGroups.Count == 0) return;
+
+        var exportDir = Path.GetDirectoryName(filepath) ?? ".";
+        foreach (var mat in scene.Materials) {
+            if (string.IsNullOrEmpty(mat.Name)) continue;
+            var source = ImportedMaterialGroups.Select(group => group.GetByName(mat.Name)).FirstOrDefault(source => source != null);
+            if (source == null) continue;
+
+            string? RelPath(string exportDir, string? gameTexPath, string suffix)
+            {
+                if (string.IsNullOrWhiteSpace(gameTexPath)) return null;
+                if (gameTexPath.Contains("/null", StringComparison.InvariantCultureIgnoreCase)
+                    || gameTexPath.Contains("\\null", StringComparison.InvariantCultureIgnoreCase)) return null;
+                var name = PathUtils.GetFilenameWithoutExtensionOrVersion(gameTexPath).ToString();
+                var ext = ExportTextureFormat.Equals("png", StringComparison.OrdinalIgnoreCase) ? ".png" : ".dds";
+                var target = Path.Combine(exportDir, "textures", name + suffix + ext);
+                return Path.GetRelativePath(exportDir, target).Replace('\\', '/');
+            }
+
+            var albedo = RelPath(exportDir, source.AlbedoTexture?.texPath, "");
+            if (albedo != null) {
+                mat.TextureDiffuse = new TextureSlot(albedo, TextureType.Diffuse, 0, TextureMapping.FromUV, 0, 1, TextureOperation.Multiply, TextureWrapMode.Wrap, TextureWrapMode.Wrap, 0);
+            }
+            var normal = RelPath(exportDir, source.NormalTexture?.texPath, "_normal");
+            if (normal != null) {
+                mat.TextureNormal = new TextureSlot(normal, TextureType.Normals, 0, TextureMapping.FromUV, 0, 1, TextureOperation.Multiply, TextureWrapMode.Wrap, TextureWrapMode.Wrap, 0);
+            }
+            var opacity = RelPath(exportDir, source.ATXXTexture?.texPath, "_alpha");
+            if (opacity != null) {
+                mat.TextureOpacity = new TextureSlot(opacity, TextureType.Opacity, 0, TextureMapping.FromUV, 0, 1, TextureOperation.Multiply, TextureWrapMode.Wrap, TextureWrapMode.Wrap, 0);
+            }
+        }
     }
 
